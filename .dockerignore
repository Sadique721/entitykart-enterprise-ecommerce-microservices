# EntityKart .dockerignore
.git
.gitignore
.idea
.vscode
.gradle
**/build/
**/bin/
node_modules/
**/node_modules/
*.apk
*.keystore
*-logs.txt
*.log
android/
flutter/
metadata.json
docker-compose.yml
Dockerfile
README.md
ARCHITECTURE_AND_FLOWS.md
HOW_TO_START.txt
build_all.bat
start_local.ps1
desktop-app/
# shared-lib: exclude heavy/generated dirs but keep source + build scripts
# (common-services/Dockerfile builds shared-lib inside Docker)
shared-lib/**
!shared-lib/gradlew
!shared-lib/gradle/
!shared-lib/build.gradle.kts
!shared-lib/settings.gradle.kts
!shared-lib/src/
